# Optiqor web (Next.js) — environment template
#
# Copy to .env.local and fill in. Auth.js v5 picks these up automatically;
# the Next.js dev server inherits them via `pnpm dev` / `make dev`.

# ---- Auth.js -------------------------------------------------------
# 32+ random bytes — `openssl rand -hex 32`. Encrypts the session
# cookie. Rotating this logs every signed-in user out on next request.
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Optional in dev. When unset (and NODE_ENV !== "production"), the
# sign-in page falls back to a Credentials form so the dashboard is
# testable without a registered GitHub OAuth App.
#
# To enable real GitHub OAuth in dev:
#   1. Create an OAuth App at https://github.com/settings/developers
#   2. Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   3. Paste the client ID + secret below.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ---- Backend proxy upstream ----------------------------------------
# next.config.ts rewrites /v1/*, /r/*, /v/*, /webhooks/*, /oauth/*,
# /healthz, /readyz to this host. Default points at the local Go API.
OPTIQOR_API_UPSTREAM=http://localhost:8080
