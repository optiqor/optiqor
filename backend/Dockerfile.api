# syntax=docker/dockerfile:1.7

# Base images are pinned by digest, not floating tag. The two ARG
# defaults below carry both a human-readable tag and an immutable
# digest so a `docker build .` produces a reproducible image without
# external lookups. Renovate keeps the digests fresh; treat the tag
# half of the value as documentation, the digest half as the contract.
# See docs/runbooks/dockerfile-digest-pinning.md for the bump procedure.
ARG GO_BUILDER_IMAGE=golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c
ARG DISTROLESS_RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

FROM ${GO_BUILDER_IMAGE} AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY . .
WORKDIR /src/backend
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/api ./cmd/api

FROM ${DISTROLESS_RUNTIME_IMAGE}
COPY --from=build /out/api /api
EXPOSE 8080 9090
USER nonroot:nonroot
ENTRYPOINT ["/api"]
