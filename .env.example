# Copy to .env (which is gitignored) for local development.
# Real production secrets come from AWS Secrets Manager — never put them here.

# Application
OPTIQOR_ENV=dev
OPTIQOR_LOG_LEVEL=debug
OPTIQOR_HTTP_ADDR=:8080
OPTIQOR_METRICS_ADDR=:9090

# Postgres
OPTIQOR_POSTGRES_DSN=postgres://optiqor:optiqor@localhost:5432/optiqor?sslmode=disable

# Redis
OPTIQOR_REDIS_ADDR=localhost:6379

# Temporal
OPTIQOR_TEMPORAL_HOSTPORT=localhost:7233
OPTIQOR_TEMPORAL_NAMESPACE=default

# Anthropic (use a dev-tier key locally; never commit real keys)
OPTIQOR_ANTHROPIC_API_KEY=

# GitHub App (development tier)
OPTIQOR_GITHUB_APP_ID=
OPTIQOR_GITHUB_APP_CLIENT_ID=
OPTIQOR_GITHUB_APP_CLIENT_SECRET=
OPTIQOR_GITHUB_APP_PRIVATE_KEY_PATH=./.local/github-app.private-key.pem
OPTIQOR_GITHUB_APP_WEBHOOK_SECRET=

# AWS (use STS AssumeRole in real deploys; localstack or empty for dev)
AWS_REGION=us-east-1

# Sentry (empty in local dev)
OPTIQOR_SENTRY_DSN=

# OpenTelemetry
OPTIQOR_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Feature flags (Unleash)
OPTIQOR_UNLEASH_URL=http://localhost:4242/api
OPTIQOR_UNLEASH_API_TOKEN=
