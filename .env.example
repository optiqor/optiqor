# Copy to .env (which is gitignored) for local development.
# Real production secrets come from AWS Secrets Manager — never put them here.

# Application
COSTIFY_ENV=dev
COSTIFY_LOG_LEVEL=debug
COSTIFY_HTTP_ADDR=:8080
COSTIFY_METRICS_ADDR=:9090

# Postgres
COSTIFY_POSTGRES_DSN=postgres://costify:costify@localhost:5432/costify?sslmode=disable

# Redis
COSTIFY_REDIS_ADDR=localhost:6379

# Temporal
COSTIFY_TEMPORAL_HOSTPORT=localhost:7233
COSTIFY_TEMPORAL_NAMESPACE=default

# Anthropic (use a dev-tier key locally; never commit real keys)
COSTIFY_ANTHROPIC_API_KEY=

# GitHub App (development tier)
COSTIFY_GITHUB_APP_ID=
COSTIFY_GITHUB_APP_CLIENT_ID=
COSTIFY_GITHUB_APP_CLIENT_SECRET=
COSTIFY_GITHUB_APP_PRIVATE_KEY_PATH=./.local/github-app.private-key.pem
COSTIFY_GITHUB_APP_WEBHOOK_SECRET=

# AWS (use STS AssumeRole in real deploys; localstack or empty for dev)
AWS_REGION=us-east-1

# Sentry (empty in local dev)
COSTIFY_SENTRY_DSN=

# OpenTelemetry
COSTIFY_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Feature flags (Unleash)
COSTIFY_UNLEASH_URL=http://localhost:4242/api
COSTIFY_UNLEASH_API_TOKEN=
