# Copy to .env (which is gitignored) for local development.
# Real production secrets come from AWS Secrets Manager — never put them here.

# Application
SEVRO_ENV=dev
SEVRO_LOG_LEVEL=debug
SEVRO_HTTP_ADDR=:8080
SEVRO_METRICS_ADDR=:9090

# Postgres
SEVRO_POSTGRES_DSN=postgres://sevro:sevro@localhost:5432/sevro?sslmode=disable

# Redis
SEVRO_REDIS_ADDR=localhost:6379

# Temporal
SEVRO_TEMPORAL_HOSTPORT=localhost:7233
SEVRO_TEMPORAL_NAMESPACE=default

# Anthropic (use a dev-tier key locally; never commit real keys)
SEVRO_ANTHROPIC_API_KEY=

# GitHub App (development tier)
SEVRO_GITHUB_APP_ID=
SEVRO_GITHUB_APP_CLIENT_ID=
SEVRO_GITHUB_APP_CLIENT_SECRET=
SEVRO_GITHUB_APP_PRIVATE_KEY_PATH=./.local/github-app.private-key.pem
SEVRO_GITHUB_APP_WEBHOOK_SECRET=

# AWS (use STS AssumeRole in real deploys; localstack or empty for dev)
AWS_REGION=us-east-1

# Sentry (empty in local dev)
SEVRO_SENTRY_DSN=

# OpenTelemetry
SEVRO_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Feature flags (Unleash)
SEVRO_UNLEASH_URL=http://localhost:4242/api
SEVRO_UNLEASH_API_TOKEN=
